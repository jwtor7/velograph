{
  "name": "velograph-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Velograph — local-first cycling analytics for Apple Health exports",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <27"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "node scripts/configure-git-hooks.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "runtime:build": "pnpm cli:build && pnpm api:build",
    "runtime:verify-artifacts": "node scripts/verify-runtime-artifacts.mjs",
    "api:build": "pnpm package:web && pnpm --filter @velograph/api build",
    "api:verify-package": "node scripts/verify-api-package.mjs",
    "cli:build": "pnpm --filter @velograph/cli build",
    "cli:verify-package": "node scripts/verify-cli-package.mjs",
    "velograph-import": "node apps/cli/dist/velograph-import.mjs",
    "app:start": "node scripts/app.mjs start",
    "app:stop": "node scripts/app.mjs stop",
    "app:status": "node scripts/app.mjs status",
    "app:restart": "node scripts/app.mjs restart",
    "app:dev": "node scripts/app.mjs dev",
    "privacy:scan": "node scripts/privacy-scan.mjs --all",
    "privacy:scan:staged": "node scripts/privacy-scan.mjs --staged",
    "license:check": "node scripts/third-party-license-gate.mjs --workspace",
    "package:web": "node scripts/package-web.mjs && node scripts/third-party-license-gate.mjs --stage-artifact apps/web/dist",
    "fixtures:generate": "node scripts/generate-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
