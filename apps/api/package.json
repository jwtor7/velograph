{
  "name": "@velograph/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Velograph local loopback HTTP API",
  "exports": {
    ".": "./dist/api-runtime.mjs"
  },
  "bin": {
    "velograph-api": "./dist/velograph-api.mjs"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <27"
  },
  "scripts": {
    "build": "node ../../scripts/build-api-runtime.mjs",
    "prepack": "node ../../scripts/build-api-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/velograph-api.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@velograph/analytics": "workspace:*",
    "@velograph/db": "workspace:*",
    "@velograph/importers": "workspace:*",
    "@velograph/shared": "workspace:*",
    "typescript": "^5.9.2"
  }
}
